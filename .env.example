# ==============================================================================
# VeriTrust AI — Environment Configuration
# ==============================================================================

# LLM Provider Selection
# Options: 'mock' (default, offline, zero-cost), 'gemini', 'openai', 'ollama'
LLM_PROVIDER=mock

# Google Gemini API Settings (Optional if using 'mock' or 'ollama')
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings (Optional if using 'mock' or 'ollama')
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local Settings (Optional if using 'mock' or cloud APIs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# RAG & Knowledge Base Settings
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=company_knowledge_base
# Initial reference similarity threshold for RAG retrieval (configurable, not a hard barrier)
SIMILARITY_THRESHOLD=0.7

# Guardrail & Workflow Parameters
MAX_CORRECTION_ATTEMPTS=3
JUDGE_SCORE_THRESHOLD=80
SAFE_FALLBACK_RESPONSE="We are currently unable to verify the policy details required to answer your request with full certainty. A customer service representative has been notified to assist you."

# Application & Database Settings
APP_ENV=development
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/veritrust.db
